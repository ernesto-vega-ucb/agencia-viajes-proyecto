# ============================================================
# Variables compartidas del monorepo
# Copia este archivo como `.env` y ajusta los valores.
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=agencia_viajes
POSTGRES_USER=agencia
POSTGRES_PASSWORD=agencia_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Keycloak (OIDC/OAuth2 externo) ----------
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=agencia-viajes
KEYCLOAK_CLIENT_ID=agencia-web
# issuer público visto por navegador y clientes del host (para validar `iss` del JWT)
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/agencia-viajes
# URL interna para descargar las claves públicas (JWT/JWKS) dentro de la red de Docker
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/agencia-viajes/protocol/openid-connect/certs

# ---------- Frontend (/apps/web) ----------
VITE_API_BASE_URL=http://localhost:8081/api/v1
VITE_SEARCH_API_BASE_URL=http://localhost:8082/api/v1
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/agencia-viajes
VITE_OIDC_CLIENT_ID=agencia-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback

# ---------- App móvil (/apps/mobile, copiar apps/mobile/.env.example -> .env) ----------
# Emulador Android usa 10.0.2.2; simulador iOS usa localhost.
# En un dispositivo físico pon la IP LAN de tu máquina, p.ej. 192.168.1.50
# EXPO_PUBLIC_API_HOST=192.168.1.50
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8081/api/v1
# EXPO_PUBLIC_SEARCH_API_BASE_URL=http://192.168.1.50:8082/api/v1
# EXPO_PUBLIC_OIDC_AUTHORITY=http://192.168.1.50:8080/realms/agencia-viajes
# EXPO_PUBLIC_OIDC_CLIENT_ID=agencia-web

# ---------- Services ----------
BOOKING_CORE_PORT=8081
SEARCH_AI_PORT=8082