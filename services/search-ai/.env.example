DATABASE_URL=postgresql://agencia:agencia_dev@localhost:5432/agencia_viajes
BOOKING_CORE_URL=http://localhost:8081/api/v1
SEARCH_AI_PORT=8082
# Modelo de Sentence Transformers en español (extra [ml] / sentence-transformers).
# Si no está instalado, se usa el fallback determinista TF-IDF + SVD.
EMBEDDING_MODEL=BAAI/bge-small-es-v1.5
# Habilita Beto (Spanish BERT) para intenciones; requiere 'transformers' y torch.
BETO_ENABLED=false