# =============================================================================
# Configuración del Agente de IA (search-ai)
# Copia este archivo a `.env` y ajusta los valores. Todas las variables son
# opcionales: si LLM_PROVIDER está vacío, el agente funciona en MODO OFFLINE
# con un planificador determinista (TF-IDF + Regresión Logística + reglas),
# ideal para la demo y para que las métricas sean estables.
# =============================================================================

# Base de datos / catálogo (igual que en docker-compose)
DATABASE_URL=postgresql://agencia:agencia_dev@localhost:5432/agencia_viajes
BOOKING_CORE_URL=http://localhost:8081/api/v1

# ---------------------------------------------------------------------------
# PROVEEDOR DE LLM (deja LLM_PROVIDER vacío para el modo offline)
# ---------------------------------------------------------------------------
# Opciones válidas: ollama | openai | deepseek | openai_compatible
#LLM_PROVIDER=ollama

# URL base compatible con la API de OpenAI (/chat/completions).
# - Ollama local:  http://localhost:11434/v1   (o http://host.docker.internal:11434/v1 si usas Docker Desktop)
# - OpenAI:        https://api.openai.com/v1
# - DeepSeek:      https://api.deepseek.com/v1
#LLM_BASE_URL=http://localhost:11434/v1

# Clave de API. Ollama local no la necesita; para OpenAI/DeepSeek usa tu clave.
#LLM_API_KEY=

# Modelo. Si se deja vacío se usa el modelo por defecto del proveedor
# (ollama -> llama3.1, openai -> gpt-4o-mini, deepseek -> deepseek-chat).
#LLM_MODEL=llama3.1:8b

# Tiempo máximo de respuesta (en segundos) de cada llamada al LLM.
#LLM_TIMEOUT=60.0

# Nº máximo de pasos del bucle ReAct cuando el LLM decide llamar herramientas.
#AGENT_MAX_STEPS=3